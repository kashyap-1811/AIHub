# Root .gitignore for AIHub Project

# ===========================================
# DATABASE FILES
# ===========================================
# SQLite database files (should not be committed)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ===========================================
# .NET / C# BACKEND
# ===========================================
# Build results
bin/
obj/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Visual Studio / Rider
.vs/
.vscode/
.idea/

# Logs
*.log

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# NuGet packages
*.nupkg
packages/
*.snupkg

# Publish output
publish/
out/

# ASP.NET Core specific
appsettings.Development.json
appsettings.Local.json
appsettings.*.json
!appsettings.json

# Entity Framework migrations (keep for schema tracking)
# Migrations/

# Test results
TestResults/
*.trx

# ===========================================
# NODE.JS / REACT FRONTEND
# ===========================================
# Dependencies
node_modules/

# Build output
dist/
build/
out/

# Dependency directories
jspm_packages/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment files
.env
.env.*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Coverage reports
coverage/
*.lcov

# Cache directories
.cache/
.parcel-cache/
.eslintcache

# IDE files
*.swp
*.swo
*~

# ===========================================
# GENERAL
# ===========================================
# Temporary files
*.tmp
*.temp
*.bak
*.backup

# Archive files (unless specifically needed)
*.zip
*.tar.gz
*.rar

# System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ===========================================
# PROJECT SPECIFIC
# ===========================================
# API Keys and secrets (if any)
secrets.json
*.secrets.json

# Local development files
local/
local_*/

# Documentation build
docs/_build/

# Backup files
*.backup
*.bak
